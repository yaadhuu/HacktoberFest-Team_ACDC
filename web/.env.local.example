# ---- public (browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# "/api" = built-in Next.js backend (default, Vercel-ready, no Python needed).
# Leave unset to use the optional Python/FastAPI service via the /api-proxy rewrite.
NEXT_PUBLIC_API_URL=/api

# ---- server only (never exposed to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=      # shared galaxies + invites
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=                 # Gemma 4 + Gemini embeddings via the Gemini API
GEMINI_MODEL=gemma-4-26b-a4b-it
# INVITE_SECRET=                # optional; rotating it revokes every shared-galaxy QR
# SEARCH_SIM_MATCH=0.56         # optional; semantic match threshold
# API_INTERNAL_URL=http://127.0.0.1:8000   # only for the optional Python service
